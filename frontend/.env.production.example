# Copy to frontend/.env.local for local dev
# For production, set these in Vercel dashboard → Project → Settings → Environment Variables

# Railway backend URL (set this after Railway deploys)
VITE_API_BASE_URL=https://your-railway-app.railway.app/api/v1
VITE_PUBLIC_API_ORIGIN=https://your-railway-app.railway.app
VITE_WS_BASE_URL=wss://your-railway-app.railway.app/ws
