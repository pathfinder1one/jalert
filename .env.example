# ─────────────────────────────────────────────────────────────
#  JALERT - Environment Variables Template
#  Copy to .env and fill in real values before deployment
# ─────────────────────────────────────────────────────────────

# App
APP_NAME="JALERT"
ENVIRONMENT=development      # development | staging | production
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000

# Database
# Local SQLite example:
# DATABASE_URL=sqlite+aiosqlite:///./jalert.db
# Production PostgreSQL example:
DATABASE_URL=postgresql+asyncpg://jalert:jalert_pass@localhost:5432/jalert_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT - CHANGE THIS IN PRODUCTION (generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_THIS_SUPER_SECRET_JWT_KEY_AT_LEAST_32_CHARS

# OpenAI
OPENAI_API_KEY=sk-...

# Local Ollama chat backend for the assistant
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT_SECONDS=120

# Twilio SMS/Voice
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# AWS (S3 for reports, Polly for TTS)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1
S3_BUCKET_REPORTS=jalert-reports

# Google Cloud (TTS)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
