APP_NAME="JALERT - Intelligent Water & Health Alert System"
APP_VERSION="1.0.0"
DEBUG=False
ENVIRONMENT="production"

# Server
HOST="0.0.0.0"
PORT=8000

# Security (Change SECRET_KEY in real production)
SECRET_KEY="replace_me_with_a_super_strong_random_secret_string"
CORS_ORIGINS=["*"] 
SENSOR_INGEST_API_KEYS=["your-secure-sensor-key-1"]

# Database
DATABASE_URL="sqlite+aiosqlite:///./jalert.db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Kafka (If not using Kafka, these won't crash the startup)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"

# LLM
## OLLAMA_URL="http://localhost:11434/api/chat"
## OLLAMA_MODEL="gemma4:31b-cloud"

# Other keys can be added here as needed for Twilio, AWS, etc.